# QuizBD / Bangladesh product deployment
# Copy to your hosting provider's env panel (Render, Fly, etc.)
# Do NOT use the Railway project tied to feature/simplified-architecture.

NODE_ENV=production
JAQUIZY_MODE=web
PRODUCT_MARKET=bangladesh

# App
PORT=3001
APP_URL=https://your-bd-domain.com

# Database (use a dedicated Supabase project for BD)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
OPENAI_API_KEY=

# Auth
JWT_SECRET=

# Optional: payment rails (enable when integrated)
BKASH_ENABLED=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=

# CORS — set to your BD domain
ALLOWED_ORIGINS=https://your-bd-domain.com
